# RabbitMQ（与主项目一致，生产环境用实际地址）
# 格式: amqp://用户名:密码@主机:端口
RABBITMQ_URL=amqp://user:password@your-host:19168
RABBITMQ_QUEUE=media.uploaded

# Docker Swarm
SWARM_STACK_NAME=retinaclip
SWARM_SERVICE_NAME=gpu-worker
# GPU 节点在 Swarm 中的 NODE ID 或 Hostname（用于 drain/active）
SWARM_GPU_NODE_ID=

# 阿里云 ECS（与主项目 AccessKey 一致即可）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_ECS_REGION=cn-shanghai
# 要按需启停的 GPU 实例 ID
SWARM_GPU_INSTANCE_ID=

# 扩缩策略
AUTOSCALE_QUEUE_SCALE_UP_THRESHOLD=1
AUTOSCALE_QUEUE_SCALE_DOWN_THRESHOLD=0
AUTOSCALE_TARGET_REPLICAS=1
# 队列空多少分钟后关机（避免频繁开关机）
AUTOSCALE_IDLE_MINUTES_BEFORE_SHUTDOWN=15
AUTOSCALE_CHECK_INTERVAL_SECONDS=30

# 本地测试：不执行真实 scale/启停，只打日志
# AUTOSCALE_DRY_RUN=true
# 仅执行一次后退出（适合 crontab 每 5 分钟执行一次）
# AUTOSCALE_SINGLE_RUN=true
