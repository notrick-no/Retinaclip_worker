# ========== 终端快捷命令（在项目根目录） ==========
# 完整说明见 TESTING.md
#
# npm start              启动 Worker
# npm run test:config    校验 .env（无网络）
# npm run test:rabbitmq  测 RabbitMQ
# npm run test:ecs       测 ECS API + 镜像
# npm run pool           检查 ECS 池
# npm run test:smoke     上面三项连通性连着跑
# npm test               单元测试（Vitest）
# npm run test:all       配置+单元+smoke+池（最全）
#
# ./scripts/rc.sh        查看 rc 子命令帮助
#
# ========== RabbitMQ（可选，默认值也有） ==========
# 格式: amqp://用户名:密码@主机:端口
RABBITMQ_URL=amqp://user:password@47.101.157.157:19168
RABBITMQ_QUEUE=media.uploaded

# ========== 阿里云 ECS（必填） ==========
ALIBABA_CLOUD_ACCESS_KEY_ID=xxx
ALIBABA_CLOUD_ACCESS_KEY_SECRET=xxx
ALIYUN_ECS_REGION=cn-shanghai

# 预装算法环境的自定义镜像 ID（ECS ImageId）
ALIYUN_ECS_IMAGE_ID=xxx

# 安全组/交换机（必填）
ALIYUN_ECS_SECURITY_GROUP_ID=sg-xxx
ALIYUN_ECS_VSWITCH_ID=vsw-xxx

# 可选：可用区 ID（留空不填也可以）
# ALIYUN_ECS_ZONE_ID=cn-shanghai-b

# ECS 实例规格/命名（可选）
ALIYUN_ECS_INSTANCE_TYPE=ecs.gn6i-c8g1.2xlarge
ALIYUN_ECS_INSTANCE_NAME_PREFIX=retinaclip-worker

# 运行镜像（可选；不填会用 retinaclip-processor:latest）
WORKER_PROCESSING_IMAGE=retinaclip-processor:latest

# 按队列消息 operation + quality_preset 路由容器镜像（JSON 对象，字符串键 -> 镜像引用）
# 查找顺序：sortedOps@quality → sortedOps → @quality → WORKER_PROCESSING_IMAGE
# 例：消息 "operation":["remove subtitles"],"quality_preset":"normal" 对应键 "remove subtitles@normal"
# WORKER_PROCESSING_IMAGE_MAP={"remove subtitles@normal":"registry.cn-shanghai.aliyuncs.com/ns/retinaclip-subtitle:normal","remove subtitles":"registry.cn-shanghai.aliyuncs.com/ns/retinaclip-subtitle:latest"}
# 内网 HTTP 仓库示例：172.16.0.70:5000/quzimu-container:v4（须与安全组放行 5000、仓库监听 0.0.0.0 一致）
# WORKER_PROCESSING_IMAGE=172.16.0.70:5000/quzimu-container:v4

# 额外写入 Docker insecure-registries（逗号分隔）；镜像名为 host:port/... 时也会自动加入该 host:port
# WORKER_DOCKER_INSECURE_REGISTRIES=172.16.0.70:5000
# 私有仓需认证时（勿把密码提交到 Git，仅部署机 .env）
# WORKER_DOCKER_REGISTRY_USERNAME=robot
# WORKER_DOCKER_REGISTRY_PASSWORD=***
# WORKER_DOCKER_REGISTRY_SERVER=172.16.0.70:5000

# ========== 池机 docker run（与手动命令对齐）==========
# 网络：host（默认，历史行为）或 bridge（配合下面端口映射，贴近 docker run -p ...）
# WORKER_DOCKER_NETWORK_MODE=host
# bridge 时生效，逗号分隔，例如：8080:8080,6006:6006,5000:5000
# WORKER_DOCKER_PUBLISH_PORTS=
# 宿主机目录绑定进容器（如 NAS 挂载后的 DiffuEraser）；留空则不加 -v
# WORKER_DOCKER_VOLUME_HOST=/mnt/DiffuEraser/DiffuEraser/
# WORKER_DOCKER_VOLUME_CONTAINER=/DiffuEraser
# 非空时在镜像后追加：/bin/bash -c '<值>'（等价于手动命令里的 ./deploy.sh）
# WORKER_DOCKER_BASH_COMMAND=./deploy.sh

# ========== NAS 挂载（NFS） ==========
# 用于宿主机启动时自动挂载 NAS 到 /mnt
# 注意：挂载点域名要填 NAS 控制台给的“挂载目标/挂载点”域名或 IP（不要填 ECS 实例 ID）。
# WORKER_NAS_MOUNT_DOMAIN=<your-nas-mount-target-domain>
# 默认导出路径为 /
# WORKER_NAS_EXPORT_PATH=/
# 默认本地挂载目录为 /mnt
# WORKER_NAS_MOUNT_POINT=/mnt
# NAS ID：仅用于日志定位
# WORKER_NAS_ID=3e41f4bcd1

# 池实例第二标签 retinaclip:pool-profile 的值（键规则与 IMAGE_MAP 相同）
# WORKER_ECS_POOL_PROFILE_MAP={"remove subtitles@normal":"subtitle","upscale@high":"upscale"}

# ========== 计费/并发策略（可选） ==========
WORKER_MAX_INSTANCES=5
WORKER_PREFETCH_COUNT=2

# ECS「池」：为 true 时 Worker 不消费 RabbitMQ；按队列深度（checkQueue）把 Stopped 池机启动为 Running，并默认用云助手跑与 runTask 池路径相同的脚本（拉镜像、docker run）。
# 常驻消费端建议 WORKER_POOL_BOOTSTRAP_DOCKER_DETACHED=true（默认）。非池路径仍可用 QueueConsumer + runTask。
# 实例标签 retinaclip:lifecycle=pool（可用 WORKER_ECS_POOL_TAG_VALUE 改值）。池无可用时再新建临时实例（ephemeral）仅适用于非池消费模式。
WORKER_ECS_POOL_ENABLED=true
WORKER_ECS_POOL_TAG_VALUE=pool
# 池模式下调度轮询间隔（毫秒）；仅观测队列深度，不 prefetch、不 consume
# WORKER_SCHEDULER_POLL_INTERVAL_MS=15000
# 队列连续空闲多久后开始自动收缩 Running 池机（毫秒，默认 180000=3分钟）
# WORKER_SCHEDULER_SCALE_DOWN_IDLE_MS=180000
# 空闲收缩时最少保留几台 Running 池机（保温机），默认 0
# WORKER_SCHEDULER_MIN_RUNNING_INSTANCES=0
# 当 WORKER_ECS_POOL_PROFILE_FILTER_ENABLED=true 时，调度只统计/启动带该 profile 标签的池机（与任务路由 profile 对齐）
# WORKER_SCHEDULER_POOL_PROFILE=subtitle
# 池 profile 标签键（默认 retinaclip:pool-profile；与 WORKER_ECS_POOL_PROFILE_MAP 搭配）
# WORKER_ECS_POOL_PROFILE_TAG_KEY=retinaclip:pool-profile
# 是否在挑选池实例时按 profile 标签过滤（默认 false：只要有 pool 生命周期标签即可，不校验镜像/规格；多业务分子池时改为 true）
# WORKER_ECS_POOL_PROFILE_FILTER_ENABLED=true
#
# 池机 Stopped→Running 后默认：云助手跑与 runTask 池路径相同的脚本（NAS、docker pull、docker run）。
# WORKER_POOL_BOOTSTRAP_DOCKER_DETACHED=true（默认）：docker run -d --restart unless-stopped，适合常驻 MQ 消费；false 则与单任务前台一致（云助手长时间阻塞）。
# WORKER_POOL_BOOTSTRAP_MESSAGE_ID=pool-mq-worker  → 容器 retinaclip-task-pool-mq-worker；再次 bootstrap 会先删同名容器
# WORKER_POOL_BOOTSTRAP_VIDEO_URL / WORKER_POOL_BOOTSTRAP_WEBHOOK_URL 占位（--env-file；镜像不用可忽略）
# WORKER_POOL_BOOTSTRAP_PROCESSING_IMAGE=...       非空则覆盖默认镜像路由
# 覆盖优先级：WORKER_ECS_POOL_BOOT_COMMAND > WORKER_ECS_POOL_DOCKER_CONTAINER > 上述默认完整脚本
# WORKER_ECS_POOL_BOOT_DELAY_MS=20000
# WORKER_ECS_POOL_BOOT_COMMAND=cd /opt/app && docker compose up -d
# WORKER_ECS_POOL_DOCKER_CONTAINER=my-existing-container

# 主规格无库存时依次尝试的备选规格（逗号分隔，如 gn7i 无货试 gn6i）
# ALIYUN_ECS_INSTANCE_TYPE_FALLBACK=ecs.gn6i-c8g1.2xlarge,ecs.gn5i-c4g1.xlarge

# UserData 内 Docker：auto=缺失则 dnf 装 Docker CE；require_host=必须自定义镜像已装 Docker（推荐生产）
# WORKER_ECS_USERDATA_DOCKER_POLICY=require_host

# 创建前调用 DescribeAvailableResource 调整规格尝试顺序（多备选时建议 true）
# WORKER_ECS_PREFILTER_AVAILABLE_RESOURCE=true

# 用抢占式（Spot）
ALIYUN_ECS_USE_SPOT=true
ALIYUN_ECS_SPOT_STRATEGY=SpotAsPriceGo
# 仅 SpotWithPriceLimit 才需要
# ALIYUN_ECS_SPOT_PRICE_LIMIT=0.5

# 带宽（可选；新建临时实例用；池机若为 0 且无公网 IP，可配合下面自动分配）
ALIYUN_ECS_BANDWIDTH_OUT=100

# 实例 Running 后是否要求具备公网 IP 或 EIP（访问公网 RabbitMQ 时建议 true）
WORKER_ECS_REQUIRE_PUBLIC_IP=true
# 无公网 IP 时是否调用阿里云 API 自动升带宽并分配公网 IP（需余额/权限；MQ 在 VPC 内可关）
WORKER_ECS_AUTO_ALLOCATE_PUBLIC_IP=true

# 系统盘（可选）
ALIYUN_ECS_SYSTEM_DISK_SIZE=40
ALIYUN_ECS_SYSTEM_DISK_CATEGORY=cloud_essd

# 任务/轮询超时（可选）
WORKER_TASK_TIMEOUT=1800000
WORKER_INSTANCE_START_TIMEOUT=300000
WORKER_POLL_INTERVAL=10000

# ========== Webhook（必填） ==========
WEBHOOK_SECRET=xxx

# webhook 发送参数（可选）
WORKER_WEBHOOK_TIMEOUT=10000
WORKER_WEBHOOK_MAX_RETRIES=3
WORKER_WEBHOOK_RETRY_INTERVAL=1000

# ========== 重试与健康检查（可选） ==========
WORKER_RETRY_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_INTERVAL=5000
WORKER_RETRY_MAX_INTERVAL=60000

WORKER_HEALTH_CHECK_INTERVAL=30000
WORKER_ZOMBIE_CHECK_INTERVAL=60000

# ========== 日志级别（可选） ==========
WORKER_LOG_LEVEL=info

# ========== 可选：Mock 处理（仅测试用） ==========
# WORKER_MOCK_PROCESSING=true
# WORKER_MOCK_DELAY_SECONDS=60

# ========== 优雅关闭（可选） ==========
WORKER_SHUTDOWN_GRACE_MS=60000