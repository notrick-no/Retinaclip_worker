# 把本文件复制为 .env 后填写；勿把真实密钥提交到 Git。
# 运行方式见 scripts/RUN.txt
#
# ========== RabbitMQ（PPIO 调度器、本地联调建议）==========
RABBITMQ_URL=amqp://user:password@host:5672
RABBITMQ_QUEUE=media.uploaded
# RABBITMQ_MEDIA_UPLOAD=media.uploaded
# MEDIA_QUEUE=media.uploaded
BACKEND_URL=http://127.0.0.1:2026
WEBHOOK_SECRET=your-webhook-hmac-secret

# ========== 派欧云 PPIO 调度器（ppio/）==========
# 也可用 PPINFRA_API_KEY
PPIO_API_KEY=
PPIO_BASE_URL=https://api.ppinfra.com

# 二选一（或同时存在时优先「仅启停」）：
# A) 只启停控制台/历史已创建的实例（不 create、不 delete）；多个备用实例用英文逗号分隔，前者 start 失败则试后者
PPIO_MANAGED_INSTANCE_ID=
# B) 无固定实例时，按队列 create 新实例需填写；多个 productId 逗号分隔，创建失败则试下一规格
PPIO_PRODUCT_ID=

# PPIO_CLUSTER_ID=
# PPIO_QUEUE_AUTOMATION=true
# 仅启停模式下列 create 相关可省略；自动 idle 时默认 stop，不会 delete
# PPIO_IDLE_ACTION=stop
# —— 空闲关机宽限 ——
# 「无任务」判定：若配置了 RABBITMQ_MANAGEMENT_URL，则须 message_count 与 messages_unacknowledged 均为 0；
# 未配置 Management 时仅看 message_count（已取走但未 ack 的在途任务可能仍跑，易误停，建议云上开 Management 插件并填 URL）。
# RABBITMQ_MANAGEMENT_URL=http://guest:guest@127.0.0.1:15672
# 与 AMQP vhost 不一致时显式写（默认从 RABBITMQ_URL 路径解析）：
# RABBITMQ_MANAGEMENT_VHOST=/
# 队列持续「无任务」达到下列毫秒后才 stop/delete 实例（例：10 分钟）：
# PPIO_IDLE_CLOSE_MS=600000
# 未设置时默认：PPIO_IDLE_CLOSE_MS 等效 300000（5min）；也可用 PPIO_SCALE_DOWN_IDLE_MS。
# PPIO_SCALE_DOWN_IDLE_MS=
# 若显式设为 PPIO_IDLE_CLOSE_MS=0，则用 PPIO_IDLE_MIN_GRACE_MS（默认 120000=2min）作为最短等待。
# PPIO_IDLE_MIN_GRACE_MS=120000
#
# —— 长任务保护（强烈建议开启）——
# 即使队列已空且满足 idle_close，也至少距离「最后一次观测到队列非空」这么久才 stop/delete。
# 这能覆盖「最后一个任务 > idle_close」以及 worker 早 ack 导致队列很快变空的误停机。
# 例：15 分钟（默认值就是 15min）；如你的视频任务可能 30min，就填 1800000。
# PPIO_MIN_WORK_WINDOW_MS=900000

# PPIO_PRODUCTS_API_PATH=/gpu-instance/openapi/v1/products
# 若控制台/文档与默认不一致，可显式指定（见 ppio/client.py 中的尝试顺序）：
# PPIO_INSTANCE_LIST_API_PATH=/gpu-instance/openapi/v1/gpu/instances
# PPIO_INSTANCE_DETAIL_API_PATH=/gpu-instance/openapi/v1/gpu/instance
# PPIO_GPU_NUM=1
# PPIO_ROOTFS_GB=50
# PPIO_IMAGE_URL=
# PPIO_CREATE_COMMAND=/bin/bash -lc "set -e; cd /opt/retinaclip && python3 -u message_queue_worker.py"
# PPIO_EXTRA_ENVS=FOO=1

# —— 管理 API（给另一项目后台调状态/启停；需与调度器同机或内网访问）——
# 设置 PPIO_ADMIN_TOKEN 后，启动时监听 HTTP：
#   GET  /api/v1/status
#   POST /api/v1/instance/start
#   POST /api/v1/instance/stop
#   GET  /health
# 鉴权：Authorization: Bearer <PPIO_ADMIN_TOKEN>  或  X-Admin-Token: <PPIO_ADMIN_TOKEN>
PPIO_ADMIN_TOKEN=
# PPIO_ADMIN_LISTEN_HOST=127.0.0.1
# PPIO_ADMIN_LISTEN_PORT=9843
# —— Railway：平台会注入 PORT；未设 PPIO_ADMIN_LISTEN_* 时自动监听 0.0.0.0:PORT。
# 未设 PPIO_ADMIN_TOKEN 时仍会起仅 /health 的占位 HTTP，避免 Web Service 健康检查失败。
# PPIO_SCHEDULER_POLL_INTERVAL_MS=15000
# PPIO_LOG_TAIL=200
# PPIO_LOG_FETCH_INTERVAL_S=30

# ========== dev/app_mgpu_resize_h_mq 等（可选）==========
# PORT=2026
# STATUS_QUEUE=processing.status

# ========== worker_simulation（可选）==========
# WORKER_PREFETCH=1
